# Default
* text=auto

# Código → siempre LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Imágenes (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary